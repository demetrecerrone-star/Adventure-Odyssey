extends "res://tests/tutorial_save_test.gd"
func run() -> void:
	root.size = Vector2i(844,390)
	for selected_class in ["Warrior","Ranger","Mage","Necromancer","Assassin","Paladin"]:
		var state = fixture(selected_class)
		var weapon: String = Save.Inventory.starter_weapon(selected_class)
		check(state.transfer(weapon,false) and state.equip(weapon),"Equip "+selected_class)
		for action in ["read_envelope","guild_assign_blacksmith","blacksmith_claim_starter","upgrade","guild_after_blacksmith","apothecary_claim_gift","guild_after_apothecary","general_store_claim_keepsake","guild_after_general_store","guild_assign_first_combat"]: take_step(state,action)
		check(state.set_location("starter_region",Vector2(1110,2250)) and state.record_encounter_victory("south_meadow_slimes"),"Complete prior assignment")
		take_step(state,"guild_complete_first_combat")
		var trained := snap(state)
		check(state.wallet_gold == 25 and state.load_saved() and snap(state) == trained,"Previous training rewards preserved")
		check(not state.record_encounter_victory("west_forest_patrol"),"No forest clear without assignment")
		move_near(state,"guild_assign_forest_patrol")
		fail_write(state,func(): return state.perform_tutorial_action("guild_assign_forest_patrol"),"forest acceptance")
		take_step(state,"guild_assign_forest_patrol")
		check(state.set_location("starter_region",Vector2(850,1230)),"Travel to forest")
		check(not state.perform_tutorial_action("guild_complete_forest_patrol").ok,"No premature remote payout")
		check(state.transfer("healing_potion",false),"Carry one original healing potion")
		var resources: Dictionary = state.combat.duplicate(true); resources.hp = 60
		check(state.commit_combat_resources(resources),"Persist pre-patrol damage")
		var world = load("res://src/starter_world.gd").new(); world.state = state
		root.add_child(world); world.set_process(false); await process_frame
		world._process_encounter(0)
		check(world.encounter.encounter_id == "west_forest_patrol" and world.encounter.enemies.size() == 2 and world.encounter.enemy_hp == 48,"Automatic forest configuration")
		check(world.encounter.hp == 60,"Travel does not silently heal")
		world.open_field_supplies(); world._use_field_potion("healing_potion")
		check(state.bag.healing_potion == 0 and state.combat.hp == 100 and world.encounter.hp == 100,"World supplies consumes/restores atomically")
		world.cancel_overlay()
		world.encounter.hp = 0; world.encounter.defeated = true
		check(world._checkpoint_combat(),"Persist defeat")
		world._process_encounter(0)
		check(is_instance_valid(world.overlay),"Defeat opens safe retry")
		DirAccess.make_dir_absolute(state.path+".tmp")
		world.cancel_overlay()
		check(world.encounter.defeated and world.encounter.hp == 0 and is_instance_valid(world.overlay),"Failed recovery save preserves defeat modal")
		DirAccess.remove_absolute(state.path+".tmp")
		world.cancel_overlay()
		check(world.encounter.hp == 100 and world.encounter.living_count() == 2 and world.player == world.encounter.retry_point,"Retry restores forest encounter at safe approach")
		check(state.bag.healing_potion == 0 and state.wallet_gold == 25,"Retry refunds no used potion or bonus gold")
		world.player = Vector2(700,950); world._update_actor()
		var before_skill: Dictionary = world.encounter.capture()
		DirAccess.make_dir_absolute(state.path+".tmp"); world.use_class_skill(0)
		check(world.encounter.capture() == before_skill,"Failed skill checkpoint rolls back effects/resources")
		DirAccess.remove_absolute(state.path+".tmp"); world.use_class_skill(0)
		check(state.combat.mana < world.encounter.max_mana and state.combat.skills[0] > 0,"Class ability in forest pays persisted mana/cooldown")
		for enemy in world.encounter.enemies:
			world.player = enemy.position+Vector2(0,60)
			check(world.can_stand(world.player),"Accessible wolf attack approach")
			for hit in 6:
				if enemy.hp <= 0: break
				world.encounter.attack_cooldown = 0
				world.attack_nearby()
			check(enemy.hp == 0,"Real basic strikes clear wolf")
		check(world.encounter.victory,"Two wolves complete encounter")
		DirAccess.make_dir_absolute(state.path+".tmp"); world._process_encounter(0)
		check(state.tutorial.stage == "forest_patrol_active" and world.message.text.contains("could not save"),"Victory failure remains visible/retryable")
		DirAccess.remove_absolute(state.path+".tmp"); world._process_encounter(2.1)
		check(state.tutorial.stage == "return_guild_forest" and state.wallet_gold == 25 and state.encounter_is_complete("west_forest_patrol"),"Saved forest victory awaits guild reward")
		check(state.load_saved() and state.bag.healing_potion == 0,"Clear/resource receipt reloads without consumed item refund")
		world.queue_free(); await process_frame
		world = load("res://src/starter_world.gd").new(); world.state = state
		root.add_child(world); world.set_process(false); await process_frame; world._process_encounter(0)
		for node in world.enemy_nodes: check(not node.visible,"Cleared forest never respawns on reload")
		world.queue_free(); await process_frame
		move_near(state,"guild_complete_forest_patrol")
		fail_write(state,func(): return state.perform_tutorial_action("guild_complete_forest_patrol"),"forest payment")
		take_step(state,"guild_complete_forest_patrol")
		check(state.tutorial.stage == "forest_patrol_complete" and state.wallet_gold == 65,"Exactly25+40 guild gold earned")
		var complete := snap(state)
		check(state.record_encounter_victory("west_forest_patrol") and snap(state) == complete,"Late victory does not pay again")
		check(state.record_encounter_victory("south_meadow_slimes") and snap(state) == complete,"Old victory replay cannot regress forest")
		check(state.load_saved() and state.wallet_gold == 65,"Both completed assignments persist")
		check(state.stats == trained.stats,"No unimplemented XP/Luck grant")
		var bad := snap(state); bad.wallet_gold += 40; reject_corrupt(state,bad,"Forged second forest reward")
		bad = snap(state); bad.tutorial.reward_receipts.erase("guild.west_forest_patrol.gold"); reject_corrupt(state,bad,"Missing forest reward receipt")
	for path in paths: DirAccess.remove_absolute(path)
	print("FOREST INTEGRATION: %d checks; failures: %d"%[checks,failures])
	quit(1 if failures else 0)
