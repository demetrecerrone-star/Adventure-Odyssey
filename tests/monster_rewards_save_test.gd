extends "res://tests/tutorial_save_test.gd"
func run() -> void:
	for selected_class in ["Warrior","Ranger","Mage","Necromancer","Assassin","Paladin"]:
		var state = fixture(selected_class)
		var weapon: String = Save.Inventory.starter_weapon(selected_class)
		check(state.transfer(weapon,false) and state.equip(weapon),"Equip starter")
		check(not state.record_enemy_defeats("south_meadow_slimes",[0],state.combat),"Cannot award before quest")
		for action in ["read_envelope","guild_assign_blacksmith","blacksmith_claim_starter","upgrade","guild_after_blacksmith","apothecary_claim_gift","guild_after_apothecary","general_store_claim_keepsake","guild_after_general_store","guild_assign_first_combat"]: take_step(state,action)
		check(state.set_location("starter_region",Vector2(1000,2020)),"Enter meadow")
		fail_write(state,func(): return state.record_enemy_defeats("south_meadow_slimes",[0],state.combat),"Monster reward")
		check(state.wallet_gold == 0 and state.wallet_sigils == 0,"Failed reward grants no partial currency")
		check(state.record_enemy_defeats("south_meadow_slimes",[0],state.combat),"First slime rewarded")
		check(state.wallet_gold == 3 and state.wallet_sigils == 1 and state.get_progression_summary().total_xp == 10,"Exact first reward")
		var once := snap(state)
		check(state.record_enemy_defeats("south_meadow_slimes",[0,0],state.combat) and snap(state) == once,"Duplicate spawn notification no write")
		check(state.load_saved() and state.enemy_is_defeated("south_meadow_slimes",0),"Defeat receipt survives reload")
		check(not state.record_enemy_defeats("south_meadow_slimes",[3],state.combat),"Unknown spawn rejected")
		check(not state.record_enemy_defeats("west_forest_patrol",[0],state.combat),"Future assignment cannot grant")
		check(state.record_enemy_defeats("south_meadow_slimes",[0,1,2],state.combat),"Remaining slime rewards")
		check(state.wallet_gold == 9 and state.wallet_sigils == 3 and state.stats.level == 1,"Partial XP below first threshold")
		check(state.record_encounter_victory("south_meadow_slimes"),"First clear")
		take_step(state,"guild_complete_first_combat"); take_step(state,"guild_assign_forest_patrol")
		check(state.set_location("starter_region",Vector2(850,1230)),"Enter forest")
		check(state.record_enemy_defeats("west_forest_patrol",[0,1],state.combat),"Wolves rewarded")
		check(state.wallet_gold == 50 and state.wallet_sigils == 7 and state.stats.level == 2,"Gold plus quest payment, separate Sigils, level2")
		check(state.get_stat_summary().unspent_points == 5 and state.get_stat_summary().luck_total_xp == 0,"Five free points, no normal-kill Luck XP")
		check(state.get_progression_summary().xp == 0 and state.get_progression_summary().xp_required == 150,"XP threshold rolls over")
		check(state.allocate_stat_points({"STR":2,"VIT":3},state.stats.revision).ok and state.get_stat_summary().unspent_points == 0,"Earned five points can actually be allocated")
		check(state.record_enemy_defeats("west_forest_patrol",[0,1],state.combat) and state.get_stat_summary().unspent_points == 0,"Duplicate kill cannot re-award spent points")
		check(state.record_encounter_victory("west_forest_patrol"),"Forest clear")
		take_step(state,"guild_complete_forest_patrol")
		check(state.wallet_gold == 90 and state.wallet_sigils == 7,"Quest gold remains independent of monster rewards")
		var completed := snap(state)
		check(state.record_enemy_defeats("west_forest_patrol",[0,1],state.combat) and snap(state) == completed,"Late duplicate after guild return remains an idempotent no-op")
		fail_write(state,func(): return state.purchase_cosmetic("armor_moonweave"),"Cosmetic purchase")
		check(state.wallet_sigils == 7 and not state.cosmetics.owned.has("armor_moonweave"),"No lost Sigils on failed purchase")
		check(not state.equip_cosmetic("armor_moonweave"),"Unowned cosmetic rejected")
		check(state.purchase_cosmetic("armor_moonweave") and state.wallet_sigils == 4,"Purchase charges3 Sigils")
		once = snap(state)
		check(state.purchase_cosmetic("armor_moonweave") and snap(state) == once,"Repeated purchase no debit")
		check(state.equip_cosmetic("armor_moonweave") and state.equip_cosmetic("armor_original"),"Owned and default equip free")
		check(state.purchase_cosmetic("bed_riverside") and state.wallet_sigils == 0,"Second cosmetic costs4")
		check(not state.purchase_cosmetic("armor_emberweave"),"Insufficient Sigils rejected")
		check(state.load_saved() and state.wallet_sigils == 0 and state.stats.level == 2,"Purchases and level survive reload")
		var good := snap(state)
		var bad := good.duplicate(true); bad.wallet_sigils = 1; reject_corrupt(state,bad,"Forged Sigil balance")
		bad = good.duplicate(true); bad.progression.kills["quest_v1:south_meadow_slimes:0"].xp = 999; reject_corrupt(state,bad,"Forged monster XP")
		# Genuine schema10 clear receipts are historical evidence, not stage guesses.
		bad = good.duplicate(true); bad.version = 10; bad.erase("progression"); reject_corrupt(state,bad,"Partial downgraded economy metadata cannot reset owned cosmetics")
		var old := good.duplicate(true); old.version = 10
		for field in ["progression","wallet_sigils","cosmetics","cosmetic_receipts"]: old.erase(field)
		old.wallet_gold = 65; old.stats = Save.Stats.initial_state()
		write_json(state.path,old)
		check(state.load_saved() and state.wallet_gold == 90 and state.wallet_sigils == 7 and state.stats.level == 2,"Historical verified clears rewarded once")
		once = snap(state)
		check(state.load_saved() and snap(state) == once,"Second migration load cannot repeat historical rewards")
	for path in paths: DirAccess.remove_absolute(path)
	print("MONSTER REWARD SAVE CHECKS: %d; failures: %d" % [checks,failures])
	quit(1 if failures else 0)
