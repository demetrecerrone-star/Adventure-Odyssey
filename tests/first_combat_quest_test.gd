extends "res://tests/tutorial_save_test.gd"

func run() -> void:
	for selected_class in ["Warrior", "Ranger", "Mage", "Necromancer", "Assassin", "Paladin"]:
		var state = fixture(selected_class)
		var weapon: String = Save.Inventory.starter_weapon(selected_class)
		check(state.transfer(weapon, false) and state.equip(weapon), "Equip class starter")
		check(not state.record_encounter_victory(Save.FIRST_ENCOUNTER), "Cannot finish encounter before assignment")
		for action in ["read_envelope", "guild_assign_blacksmith", "blacksmith_claim_starter", "upgrade", "guild_after_blacksmith", "apothecary_claim_gift", "guild_after_apothecary", "general_store_claim_keepsake", "guild_after_general_store"]:
			take_step(state, action)
		var legacy := snap(state)
		var old_bytes := FileAccess.get_file_as_string(state.path)
		check(state.load_saved() and snap(state) == legacy and FileAccess.get_file_as_string(state.path) == old_bytes, "Existing pending-combat v9 save loads unchanged")
		check(not state.record_encounter_victory(Save.FIRST_ENCOUNTER), "Guild briefing does not count as victory")
		check(state.set_location("starter_region", Vector2(690,2150)), "Travel to meadow")
		check(not state.perform_tutorial_action("guild_assign_first_combat").ok, "Must accept at guild counter")
		move_near(state, "guild_assign_first_combat")
		fail_write(state, func(): return state.perform_tutorial_action("guild_assign_first_combat"), "accept assignment")
		take_step(state, "guild_assign_first_combat")
		check(state.tutorial.stage == "first_combat_active", "Assignment active")
		check(not state.perform_tutorial_action("first_combat_completed").ok, "Dialogue cannot dispatch victory")
		check(not state.perform_tutorial_action("guild_complete_first_combat").ok, "No early guild payment")
		check(not state.record_encounter_victory(Save.FIRST_ENCOUNTER), "No indoor victory")
		check(state.set_location("starter_region", Vector2(690,2150)), "Return to meadow")
		var pre_fight := snap(state)
		check(not state.record_encounter_victory("other_encounter") and snap(state) == pre_fight, "Unknown encounter rejected")
		check(state.load_saved() and state.tutorial.stage == "first_combat_active" and not state.encounter_is_complete(Save.FIRST_ENCOUNTER), "Interrupted encounter remains retryable without loot")
		fail_write(state, func(): return state.record_encounter_victory(Save.FIRST_ENCOUNTER), "victory")
		check(state.record_encounter_victory(Save.FIRST_ENCOUNTER), "Controller victory saved")
		check(state.tutorial.stage == "return_guild_first_combat" and state.encounter_is_complete(Save.FIRST_ENCOUNTER), "Victory directs guild return and prevents respawn")
		check(state.wallet_gold == 0 and state.chest_gold == 100, "Kill itself grants no money")
		var won := snap(state)
		var bytes := FileAccess.get_file_as_string(state.path)
		check(state.record_encounter_victory(Save.FIRST_ENCOUNTER) and snap(state) == won and bytes == FileAccess.get_file_as_string(state.path), "Victory duplicates do not write or reward")
		check(state.load_saved() and state.encounter_is_complete(Save.FIRST_ENCOUNTER), "Clear survives reload")
		check(not state.perform_tutorial_action("guild_complete_first_combat").ok, "Payment requires return to guild")
		move_near(state, "guild_complete_first_combat")
		fail_write(state, func(): return state.perform_tutorial_action("guild_complete_first_combat"), "guild payment")
		take_step(state, "guild_complete_first_combat")
		check(state.tutorial.stage == "tutorial_complete" and state.wallet_gold == 25 and state.chest_gold == 100, "One character-local guild payment")
		check(state.stats == pre_fight.stats, "Tutorial creates no level points or Luck XP")
		check(state.record_encounter_victory(Save.FIRST_ENCOUNTER) and state.wallet_gold == 25, "Late victory cannot duplicate payment")
		var bad := snap(state); bad.wallet_gold += 25
		reject_corrupt(state, bad, "Duplicated guild gold")
		bad = snap(state); bad.tutorial.reward_receipts.erase(Save.COMBAT_REWARD)
		reject_corrupt(state, bad, "Missing payment receipt")
		check(state.set_location("bedroom", Vector2(535,670)) and state.claim_chest_gold(), "Original chest gold remains claimable")
		check(state.wallet_gold == 125 and state.load_saved() and not state.claim_chest_gold(), "No reseed after guild completion")
		move_near(state, "apothecary_claim_gift")
		# Spend more than the original 100 total to exercise the new conservation ceiling.
		for index in range(12):
			check(state.purchase_shop_item("healing_potion", 1, "reward_purchase_%d" % index).ok, "Reward gold can be spent normally")
		check(state.load_saved(), "Purchased reward supplies persist")
		for entry in state.get_item_instances():
			check(entry.binding == "character" and not state.can_transfer_instance(entry.id, "another_character"), "All tutorial/shop goods remain character-bound")
	for path in paths: DirAccess.remove_absolute(path)
	print("FIRST COMBAT QUEST CHECKS: %d; failures: %d" % [checks, failures])
	quit(1 if failures else 0)
