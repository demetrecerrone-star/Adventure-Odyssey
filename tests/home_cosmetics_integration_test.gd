extends "res://tests/tutorial_save_test.gd"
func earned_state(selected_class: String = "Ranger", base: String = "female"):
 var state = fixture(selected_class,base)
 var weapon: String = Save.Inventory.starter_weapon(selected_class)
 check(state.transfer(weapon,false) and state.equip(weapon),"Collect and equip starter weapon")
 for action in ["read_envelope","guild_assign_blacksmith","blacksmith_claim_starter","upgrade","guild_after_blacksmith","apothecary_claim_gift","guild_after_apothecary","general_store_claim_keepsake","guild_after_general_store","guild_assign_first_combat"]: take_step(state,action)
 check(state.set_location("starter_region",Vector2(1000,2020)),"Meadow assignment")
 check(state.record_enemy_defeats("south_meadow_slimes",[0,1,2],state.combat),"Verified slime records earn first Sigils")
 check(state.record_encounter_victory("south_meadow_slimes"),"Training complete")
 take_step(state,"guild_complete_first_combat")
 take_step(state,"guild_assign_forest_patrol")
 check(state.set_location("starter_region",Vector2(850,1230)),"Forest assignment")
 check(state.record_enemy_defeats("west_forest_patrol",[0,1],state.combat),"Verified wolf records earn remaining Sigils")
 check(state.record_encounter_victory("west_forest_patrol"),"Patrol complete")
 take_step(state,"guild_complete_forest_patrol")
 check(state.set_location("bedroom",Vector2(565,670)),"Return home")
 return state
func run() -> void:
 root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
 root.size = Vector2i(844,390)
 for selected_class in ["Warrior","Ranger","Mage","Necromancer","Assassin","Paladin"]:
  var state = earned_state(selected_class)
  var before_stats: Dictionary = state.stats.duplicate(true)
  var before_gear: String = state.equipped_armor
  check(state.wallet_sigils==7 and state.wallet_gold==90,"Earned currencies remain separate")
  var room = preload("res://src/bedroom.gd").new()
  room.state=state
  root.add_child(room)
  await process_frame
  check(room.actor.cosmetic_dye=="armor_original" and room.prop_nodes.bed.material==null,"Original artwork on new wallet")
  room.player=room.anchors.bed
  room._update_actor()
  room._process(0)
  check(room.interact_button.text == "Bed","Phone hides keyboard-only interaction hint")
  room.interact()
  check(is_instance_valid(room.overlay),"Bed opens cosmetic selection")
  room.overlay.selected="armor_moonweave"
  room.overlay._purchase()
  check(state.wallet_sigils==7,"Preview confirmation does not spend")
  DirAccess.make_dir_absolute(state.path+".tmp")
  room.overlay._purchase()
  check(state.wallet_sigils==7 and not state.cosmetics.owned.has("armor_moonweave"),"Failed UI purchase preserves full wallet")
  DirAccess.remove_absolute(state.path+".tmp")
  room.overlay._purchase(); room.overlay._purchase()
  check(state.wallet_sigils==4 and state.cosmetics.owned.has("armor_moonweave"),"Confirmed UI purchase saved")
  var once:=snap(state)
  check(state.purchase_cosmetic("armor_moonweave") and snap(state)==once,"Repeat purchase idempotent")
  DirAccess.make_dir_absolute(state.path+".tmp")
  room.overlay._equip()
  check(room.actor.cosmetic_dye=="armor_original" and state.cosmetics.equipped.armor_dye=="armor_original","Failed equip leaves renderer and save unchanged")
  DirAccess.remove_absolute(state.path+".tmp")
  room.overlay._equip()
  check(room.actor.cosmetic_dye=="armor_moonweave","Successful equip updates independent avatar layer")
  room.overlay.selected="bed_riverside"
  room.overlay._purchase(); room.overlay._purchase(); room.overlay._equip()
  check(state.wallet_sigils==0 and room.prop_nodes.bed.material!=null,"Blanket purchase/equip updates only bed layer")
  check(room.prop_nodes.chest.material==null and room.prop_nodes.mirror.material==null,"Chest and mirror untouched")
  check(state.stats==before_stats and state.equipped_armor==before_gear and state.wallet_gold==90,"No stat/armor/gold effect")
  check(not state.purchase_cosmetic("armor_emberweave"),"No negative Sigil spending")
  check(state.load_saved() and state.cosmetics.equipped.bed=="bed_riverside" and state.wallet_sigils==0,"Saved ownership/equipment survives reload")
  room.cancel_overlay()
  room.player=room.anchors.mirror; room.interact()
  check(is_instance_valid(room.overlay) and room.overlay.mirror_mode,"Mirror remains functional")
  room.cancel_overlay()
  room.player=room.anchors.chest; room.interact()
  check(is_instance_valid(room.overlay),"Storage chest remains functional")
  room.cancel_overlay()
  check(state.equip_cosmetic("armor_original") and state.equip_cosmetic("bed_oak_green"),"Free defaults at zero Sigils")
  room._apply_cosmetics()
  check(room.actor.armor.material==null and room.prop_nodes.bed.material==null,"Restores byte-original assets without palette")
  room.queue_free(); await process_frame
 for path in paths: DirAccess.remove_absolute(path)
 print("HOME COSMETICS INTEGRATION CHECKS: %d; failures: %d" % [checks,failures])
 quit(1 if failures else 0)
